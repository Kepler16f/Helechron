<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_payment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top header: Accent dot + Title (single-line) + Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_payment_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_btn_circle" />

        <TextView
            android:id="@+id/widget_payment_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="付款码"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/widget_payment_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="刷新">

            <ImageView
                android:id="@+id/widget_payment_refresh_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_btn_circle" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh" />
        </FrameLayout>
    </LinearLayout>

    <!-- Nested tonal QR frame -->
    <FrameLayout
        android:id="@+id/widget_payment_qr_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tonal_tile"
        android:padding="6dp">

        <FrameLayout
            android:id="@+id/widget_payment_qr_pad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_qr_bg"
            android:padding="5dp">

            <ImageView
                android:id="@+id/widget_payment_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="付款码二维码"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Empty placeholder -->
        <LinearLayout
            android:id="@+id/widget_payment_empty_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_payment_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="点击打开付款码"
                android:textColor="@color/widget_accent"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="打开应用后自动同步"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 20-digit barcode text (strictly single-line) -->
    <TextView
        android:id="@+id/widget_payment_code_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9.5sp"
        android:textStyle="bold" />
</LinearLayout>
